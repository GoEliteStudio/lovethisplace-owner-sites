---
import InquiryForm from './InquiryForm.astro';
import molontaPresentation from '../content/media/molonta-presentation.json' with { type: 'json' };

interface Props {
  villa: any;
  slug: string;
  lang: string;
  completeGalleryHref?: string;
  privacyHref?: string;
}

const {
  villa,
  slug,
  lang,
  completeGalleryHref = `/villas/${slug}/${lang}/gallery/`,
  privacyHref,
} = Astro.props;
const images = Array.isArray(villa.images) ? villa.images : [];
const desktopHero = images[0];
const requestedMobileHero = String(villa.hero?.mobileImage || '');
const requestedPriorityHeroes = Array.isArray(villa.hero?.priorityImages)
  ? villa.hero.priorityImages
  : [];
const imageBySource = new Map(images.map((image: any) => [image.src, image]));
const uniqueHeroImages = (sources: string[]) => Array.from(new Set(sources))
  .map((source) => imageBySource.get(source))
  .filter(Boolean);
const desktopHeroSlides = uniqueHeroImages([
  ...requestedPriorityHeroes,
  ...images.map((image: any) => image.src),
]).slice(0, 3);
const mobileHeroSlides = uniqueHeroImages([
  requestedMobileHero,
  ...requestedPriorityHeroes,
  ...images.map((image: any) => image.src),
]).slice(0, 3);
const heroFrames = desktopHeroSlides.map((desktop: any, index: number) => ({
  desktop,
  mobile: mobileHeroSlides[index] || desktop,
}));
const heroAlt = String(villa.hero?.imageAlt || desktopHero?.alt || villa.name || '');
const completeGallery = villa.completeGallery || { imageCount: images.length, chapterCount: 1 };
const storyParagraphs = String(villa.content?.overview || '').split(/\n\s*\n/).filter(Boolean);
const facts = villa.content?.signatureFacts || [];
const included = villa.content?.included || [];
const addOns = villa.content?.addOns || [];
const bookingNotes = villa.content?.bookingNotes || [];
const faqs = villa.content?.faq || [];
const rates = villa.seasons || [];
const galleryPreviewIndexes = [1, 3, 8, 6, 5, 7].filter((index) => images[index]);
const galleryPreview = galleryPreviewIndexes.map((galleryIndex) => ({
  ...images[galleryIndex],
  galleryIndex
}));

const sourceWidthById: Record<string, number> = {
  'hero-estate-twilight': 1536,
  'private-beach': 2000,
};
const mediaId = (src: string) => src.split('/').at(-1)?.replace(/\.webp$/i, '') ?? '';
const presentationFor = (src: string) =>
  molontaPresentation[mediaId(src) as keyof typeof molontaPresentation] as
    | { dominantColor: string; placeholder?: string }
    | undefined;
const sourceWidth = (src: string) => sourceWidthById[mediaId(src)] ?? 2048;
const asFormat = (src: string, format: 'webp' | 'avif') => src.replace(/\.webp$/i, `.${format}`);
const variant = (src: string, width: number, format: 'webp' | 'avif' = 'webp') =>
  src.replace(/\.webp$/i, `-${width}.${format}`);
const srcset = (src: string, format: 'webp' | 'avif' = 'webp') => [640, 960, 1280]
  .filter((width) => width < sourceWidth(src))
  .map((width) => `${variant(src, width, format)} ${width}w`)
  .concat(`${asFormat(src, format)} ${sourceWidth(src)}w`)
  .join(', ');
const lightboxHeights = [1067, 1067, 1067, 1015, 1067, 900, 900, 900, 900, 900, 900, 900, 900, 900, 900];
const GALLERY_CARD_SIZES = '(max-width: 700px) calc(100vw - 28px), (max-width: 900px) calc(50vw - 24px), (max-width: 1100px) calc(50vw - 36px), 42vw';
const GALLERY_MODAL_SIZES = '(max-width: 760px) calc(100vw - 16px), calc(100vw - 180px)';
const lightboxItems = images.map((item: any, index: number) => ({
  src: variant(item.src, 1280),
  srcset: srcset(item.src),
  avifSrcset: srcset(item.src, 'avif'),
  width: 1280,
  height: lightboxHeights[index] ?? 900,
  alt: item.alt,
  caption: item.caption,
  sizes: GALLERY_MODAL_SIZES,
}));
---

<main class="heritage-site" id="overview">
  <section class="heritage-hero" aria-labelledby="property-title">
    <div class="heritage-hero__media" data-cinematic-hero>
      {heroFrames.map((frame: any, index: number) => (
        <picture
          class:list={['heritage-hero__slide', { 'is-active': index === 0 }]}
          data-hero-slide
          data-hero-index={index}
          data-hydrated={index === 0 ? 'true' : 'false'}
          aria-hidden={index === 0 ? 'false' : 'true'}
          style={`--hero-placeholder-desktop: ${presentationFor(frame.desktop.src)?.placeholder ? `url("${presentationFor(frame.desktop.src)?.placeholder}")` : 'none'}; --hero-placeholder-mobile: ${presentationFor(frame.mobile.src)?.placeholder ? `url("${presentationFor(frame.mobile.src)?.placeholder}")` : 'none'}; background-color: ${presentationFor(frame.mobile.src)?.dominantColor ?? '#171512'};`}
        >
          {index === 0 ? (
            <source type="image/avif" media="(min-width: 761px)" srcset={srcset(frame.desktop.src, 'avif')} sizes="100vw" />
          ) : (
            <source type="image/avif" media="(min-width: 761px)" data-srcset={srcset(frame.desktop.src, 'avif')} data-sizes="100vw" />
          )}
          {index === 0 ? (
            <source media="(min-width: 761px)" srcset={srcset(frame.desktop.src)} sizes="100vw" />
          ) : (
            <source media="(min-width: 761px)" data-srcset={srcset(frame.desktop.src)} data-sizes="100vw" />
          )}
          {index === 0 ? (
            <source type="image/avif" srcset={srcset(frame.mobile.src, 'avif')} sizes="100vw" />
          ) : (
            <source type="image/avif" data-srcset={srcset(frame.mobile.src, 'avif')} data-sizes="100vw" />
          )}
          {index === 0 ? (
            <img
              src={variant(frame.mobile.src, 1280)}
              srcset={srcset(frame.mobile.src)}
              sizes="100vw"
              width="1920"
              height="1080"
              alt={heroAlt}
              fetchpriority="high"
              decoding="async"
            />
          ) : (
            <img
              data-src={variant(frame.mobile.src, 1280)}
              data-srcset={srcset(frame.mobile.src)}
              data-sizes="100vw"
              width="1920"
              height="1080"
              alt=""
              fetchpriority="low"
              decoding="async"
            />
          )}
        </picture>
      ))}
    </div>
    <div class="heritage-hero__scrim"></div>
    <div class="heritage-hero__content">
      <p class="eyebrow">{villa.hero.eyebrow}</p>
      <h1 id="property-title">{villa.hero.title}</h1>
      <p class="heritage-hero__subtitle">{villa.hero.subtitle}</p>
      <div class="heritage-hero__actions">
        <a href="#story" class="button button--light">{villa.hero.ctaText}</a>
        <a href="#inquire" class="button button--ghost">Check availability</a>
      </div>
    </div>
    <a class="heritage-hero__scroll" href="#story" aria-label="Continue to the estate story">
      <span>Scroll</span><i aria-hidden="true"></i>
    </a>
  </section>

  <section class="fact-ribbon" aria-label="Property facts">
    {facts.map((fact: any) => (
      <div class="fact-ribbon__item">
        <strong>{fact.value}</strong>
        <span>{fact.label}</span>
      </div>
    ))}
  </section>

  <section class="story section-shell" id="story">
    <div class="section-marker"><span>01</span><i></i></div>
    <div class="story__grid">
      <div class="story__heading">
        <p class="eyebrow eyebrow--ink">The experience</p>
        <h2>{villa.headlines.overview}</h2>
        <p class="story__lead">{villa.content.overviewLead}</p>
      </div>
      <div class="story__copy">
        {storyParagraphs.map((paragraph: string) => <p>{paragraph}</p>)}
        <blockquote>{villa.content.experienceStatement}</blockquote>
      </div>
    </div>
  </section>

  <section class="editorial-pair" aria-label="Molonta setting">
    <figure class="editorial-pair__large">
      <picture style={`background-color: ${presentationFor(images[1].src)?.dominantColor ?? '#ddd'}; background-image: ${presentationFor(images[1].src)?.placeholder ? `url("${presentationFor(images[1].src)?.placeholder}")` : 'none'}; background-size: cover; background-position: center;`}><source type="image/avif" srcset={srcset(images[1].src, 'avif')} sizes="(max-width: 850px) 100vw, 64vw" /><img src={variant(images[1].src, 1280)} srcset={srcset(images[1].src)} sizes="(max-width: 850px) 100vw, 64vw" alt={images[1].alt} loading="lazy" decoding="async" /></picture>
      <figcaption>{images[1].caption}</figcaption>
    </figure>
    <figure class="editorial-pair__small">
      <picture style={`background-color: ${presentationFor(images[8].src)?.dominantColor ?? '#ddd'}; background-size: cover; background-position: center;`}><source type="image/avif" srcset={srcset(images[8].src, 'avif')} sizes="(max-width: 850px) 100vw, 30vw" /><img src={variant(images[8].src, 960)} srcset={srcset(images[8].src)} sizes="(max-width: 850px) 100vw, 30vw" alt={images[8].alt} loading="lazy" decoding="async" /></picture>
      <figcaption>{images[8].caption}</figcaption>
    </figure>
  </section>

  <section class="stay section-shell" id="amenities">
    <div class="section-marker"><span>02</span><i></i></div>
    <header class="section-intro">
      <p class="eyebrow eyebrow--ink">The stay</p>
      <h2>Everything needed.<br />Nothing imposed.</h2>
      <p>Molonta is fully private and personally supported. The essentials are included; the rest is shaped around the people who are actually coming.</p>
    </header>
    <div class="service-grid">
      <article class="service-card service-card--light">
        <span class="service-card__number">Included</span>
        <ul>{included.map((item: string) => <li>{item}</li>)}</ul>
      </article>
      <article class="service-card service-card--dark">
        <span class="service-card__number">Available on request</span>
        <ul>{addOns.map((item: string) => <li>{item}</li>)}</ul>
      </article>
    </div>
    <aside class="booking-note">
      <span>Booking notes</span>
      <ul>{bookingNotes.map((item: string) => <li>{item}</li>)}</ul>
    </aside>
  </section>

  <section class="gallery section-shell" id="gallery">
    <div class="section-marker"><span>03</span><i></i></div>
    <header class="section-intro section-intro--row">
      <div>
        <p class="eyebrow eyebrow--ink">The estate</p>
        <h2>From the terraces<br />to the water</h2>
      </div>
      <p>A curated introduction to the landscape, living spaces, shoreline and life around the estate.</p>
    </header>
    <div class="gallery-showcase">
      <div class="gallery-grid" aria-label="Selected views of Molonta Heritage Estate">
        {galleryPreview.map((image: any) => (
          <button class="gallery-card" type="button" data-gallery-index={image.galleryIndex} aria-label={`Open image ${image.galleryIndex + 1}: ${image.alt}`}>
            <picture><source type="image/avif" srcset={srcset(image.src, 'avif')} sizes={GALLERY_CARD_SIZES} /><img src={variant(image.src, 960)} srcset={srcset(image.src)} sizes={GALLERY_CARD_SIZES} alt={image.alt} loading="lazy" decoding="async" /></picture>
          </button>
        ))}
      </div>
      <div class="gallery-showcase__footer">
        <p><strong>{completeGallery.imageCount}</strong> photographs across {completeGallery.chapterCount} chapters, from the family estate to the Adriatic shoreline.</p>
        <a href={completeGalleryHref} class="gallery-open-all">Explore complete gallery <span aria-hidden="true">&rarr;</span></a>
      </div>
    </div>
  </section>

  <section class="rates section-shell" id="rates">
    <div class="section-marker"><span>04</span><i></i></div>
    <header class="section-intro section-intro--row">
      <div>
        <p class="eyebrow eyebrow--ink">2027 seasonal rates</p>
        <h2>A clear starting point</h2>
      </div>
      <p>Owner-supplied rates are shown before any optional services. Every booking is confirmed personally and in writing.</p>
    </header>
    <div class="rate-grid">
      {rates.map((rate: any) => (
        <article class="rate-card">
          <span>{rate.label}</span>
          <strong>{rate.priceDisplay.split(' · ')[0]}</strong>
          <p>{rate.priceDisplay.split(' · ')[1]}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="details section-shell" id="details">
    <div class="section-marker"><span>05</span><i></i></div>
    <div class="details__grid">
      <div>
        <p class="eyebrow eyebrow--ink">Sleeping & practical details</p>
        <h2>Four private suites.<br />One shared estate.</h2>
        <p>Molonta sleeps up to eight guests across four air-conditioned double bedrooms. Each has its own private en-suite shower bathroom, giving every pair privacy while keeping the group together.</p>
      </div>
      <div class="detail-summary">
        <p class="eyebrow eyebrow--ink">At a glance</p>
        <div class="detail-summary__facts" aria-label="Sleeping arrangement">
          <div><strong>4</strong><span>double bedrooms</span></div>
          <div><strong>4</strong><span>private en-suite bathrooms</span></div>
          <div><strong>8</strong><span>guests maximum</span></div>
          <div><strong>AC</strong><span>in every bedroom</span></div>
        </div>
        <div class="detail-list">
          <p class="eyebrow eyebrow--ink">Planning notes</p>
          {villa.content.practicalDetails.slice(2).map((detail: string) => <p class="detail-list__line">{detail}</p>)}
        </div>
      </div>
    </div>
  </section>

  <section class="location-panel" id="location">
    <div class="location-panel__media">
      <iframe
        src="https://www.google.com/maps?q=Molonta%20Heritage%20Estate%2C%20Molunat%206%2C%2020218%20Molunat%2C%20Croatia&output=embed"
        title="Map showing Molonta Heritage Estate in Molunat, Croatia"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        allowfullscreen
      ></iframe>
    </div>
    <div class="location-panel__copy">
      <p class="eyebrow">Molunat · Konavle</p>
      <h2>On the Adriatic.<br />Near Dubrovnik.</h2>
      <p>A quiet base on Croatia's southern Adriatic coast. Exact directions are shared privately before travel.</p>
      <dl>
        <div><dt>Dubrovnik Airport</dt><dd>Approx. 20 minutes</dd></div>
        <div><dt>Dubrovnik Old Town</dt><dd>Approx. 40 minutes</dd></div>
        <div><dt>Sea access</dt><dd>Inside the estate</dd></div>
      </dl>
    </div>
  </section>

  <section class="hosts section-shell" id="hosts">
    <div class="hosts__legacy" aria-label="More than sixty years of family stewardship">
      <span class="hosts__legacy-kicker">Family stewardship</span>
      <strong>60+</strong>
      <p>years above<br />the Adriatic</p>
      <div class="hosts__legacy-line"></div>
      <small>Villa Palma, 1966<br />Molonta Heritage Estate, today</small>
    </div>
    <div class="hosts__copy">
      <p class="eyebrow eyebrow--ink">Your hosts</p>
      <h2>{villa.content.hosts.names}</h2>
      <span>{villa.content.hosts.subtitle}</span>
      <p>{villa.content.hosts.bio}</p>
      <ul>{villa.content.hosts.highlights.map((item: string) => <li>{item}</li>)}</ul>
    </div>
  </section>

  <section class="faq section-shell" id="faq">
    <div class="section-marker"><span>06</span><i></i></div>
    <div class="faq__layout">
      <header class="faq__intro">
        <p class="eyebrow eyebrow--ink">Planning Molonta</p>
        <h2>Questions, answered clearly</h2>
        <p>Practical answers for guests comparing waterfront villas near Dubrovnik and planning a stay in Molunat.</p>
        <ul class="faq__topics" aria-label="Frequently asked question topics">
          <li>The stay</li><li>Location</li><li>Sea access</li><li>Services</li><li>Booking</li>
        </ul>
      </header>
      <div class="faq-list">
        {faqs.map((faq: any, index: number) => (
          <details class="faq-item" open={index === 0}>
            <summary>
              <span class="faq-list__index">{String(index + 1).padStart(2, '0')}</span>
              <span class="faq-list__question">{faq.q}</span>
              <span class="faq-list__toggle" aria-hidden="true"></span>
            </summary>
            <p>{faq.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="inquire section-shell" id="inquire">
    <div class="inquire__intro">
      <p class="eyebrow">A personal beginning</p>
      <h2>Tell us how you imagine the stay.</h2>
      <p>Share your dates and group. Availability, the applicable seasonal rate, inclusions and booking terms are confirmed in one written response before payment.</p>
      <div class="inquire__promise"><strong>Personally reviewed</strong><span>No automated confirmation and no guessed availability.</span></div>
    </div>
    <div class="inquire__form"><InquiryForm slug={slug} lang={lang} privacyHref={privacyHref} /></div>
  </section>
</main>

<dialog class="lightbox" id="heritage-lightbox" aria-label="Property image viewer">
  <button type="button" class="lightbox__close" aria-label="Close image viewer">×</button>
  <button type="button" class="lightbox__previous" aria-label="Previous image">&larr;</button>
  <figure><picture data-lightbox-picture><source type="image/avif" data-lightbox-avif /><img width={lightboxItems[0].width} height={lightboxItems[0].height} alt="" /></picture><figcaption></figcaption></figure>
  <output class="lightbox__counter" aria-live="polite"></output>
  <button type="button" class="lightbox__next" aria-label="Next image">&rarr;</button>
</dialog>

<script define:vars={{ galleryImages: lightboxItems }}>
  const cinematicHero = document.querySelector('[data-cinematic-hero]');
  if (cinematicHero instanceof HTMLElement) {
    const heroSlides = Array.from(cinematicHero.querySelectorAll('[data-hero-slide]'));
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const hydrationPromises = new WeakMap();
    let activeHeroIndex = 0;
    let heroTimer = 0;

    const hydrateHeroSlide = (slide) => {
      if (!(slide instanceof HTMLElement)) return Promise.resolve(false);
      const existing = hydrationPromises.get(slide);
      if (existing) return existing;
      if (slide.dataset.hydrated === 'true') return Promise.resolve(true);

      const image = slide.querySelector('img');
      const source = slide.querySelector('source');
      if (!(image instanceof HTMLImageElement)) return Promise.resolve(false);

      const hydration = new Promise((resolve) => {
        const finish = () => {
          image.removeEventListener('load', finish);
          image.removeEventListener('error', finish);
          const ready = image.complete && image.naturalWidth > 0;
          slide.dataset.hydrated = ready ? 'true' : 'failed';
          resolve(ready);
        };
        image.addEventListener('load', finish);
        image.addEventListener('error', finish);
        if (source instanceof HTMLSourceElement && source.dataset.srcset) {
          source.srcset = source.dataset.srcset;
          source.sizes = source.dataset.sizes || '100vw';
          delete source.dataset.srcset;
          delete source.dataset.sizes;
        }
        if (image.dataset.srcset) image.srcset = image.dataset.srcset;
        image.sizes = image.dataset.sizes || '100vw';
        if (image.dataset.src) image.src = image.dataset.src;
        delete image.dataset.src;
        delete image.dataset.srcset;
        delete image.dataset.sizes;
        if (image.complete) finish();
      });
      hydrationPromises.set(slide, hydration);
      return hydration;
    };

    const showHeroSlide = (index) => {
      const nextHeroIndex = (index + heroSlides.length) % heroSlides.length;
      if (nextHeroIndex === activeHeroIndex) return;
      activeHeroIndex = nextHeroIndex;
      heroSlides.forEach((slide, slideIndex) => {
        const isActive = slideIndex === activeHeroIndex;
        slide.classList.toggle('is-active', isActive);
        slide.setAttribute('aria-hidden', isActive ? 'false' : 'true');
      });
    };

    const scheduleHeroAdvance = () => {
      window.clearTimeout(heroTimer);
      if (document.hidden || reducedMotion.matches || heroSlides.length < 2) return;
      heroTimer = window.setTimeout(async () => {
        const nextIndex = (activeHeroIndex + 1) % heroSlides.length;
        const ready = await hydrateHeroSlide(heroSlides[nextIndex]);
        if (!ready || document.hidden || reducedMotion.matches) {
          scheduleHeroAdvance();
          return;
        }
        showHeroSlide(nextIndex);
        void hydrateHeroSlide(heroSlides[(nextIndex + 1) % heroSlides.length]);
        scheduleHeroAdvance();
      }, 7200);
    };

    const beginCinematicHero = async () => {
      if (reducedMotion.matches || heroSlides.length < 2) return;
      await hydrateHeroSlide(heroSlides[1]);
      void hydrateHeroSlide(heroSlides[2]);
      scheduleHeroAdvance();
    };

    const startHero = () => window.setTimeout(() => { void beginCinematicHero(); }, 350);
    if (document.readyState === 'complete') startHero();
    else window.addEventListener('load', startHero, { once: true });
    document.addEventListener('visibilitychange', scheduleHeroAdvance);
    reducedMotion.addEventListener('change', () => {
      if (reducedMotion.matches) {
        window.clearTimeout(heroTimer);
        showHeroSlide(0);
      } else {
        void beginCinematicHero();
      }
    });
  }

  const dialog = document.querySelector('#heritage-lightbox');
  if (dialog instanceof HTMLDialogElement) {
    const image = dialog.querySelector('img');
    const avifSource = dialog.querySelector('[data-lightbox-avif]');
    const caption = dialog.querySelector('figcaption');
    const counter = dialog.querySelector('.lightbox__counter');
    let active = 0;
    let warmTimer = 0;
    const warm = (index) => {
      const item = galleryImages[(index + galleryImages.length) % galleryImages.length];
      const neighbour = new Image();
      neighbour.decoding = 'async';
      neighbour.sizes = item.sizes;
      neighbour.srcset = item.avifSrcset || item.srcset;
      neighbour.src = item.src;
    };
    const warmAdjacent = (index) => {
      warm(index - 1);
      warm(index + 1);
    };
    image?.addEventListener('load', () => {
      const loadedIndex = active;
      window.clearTimeout(warmTimer);
      warmTimer = window.setTimeout(() => {
        if (dialog.open && active === loadedIndex) warmAdjacent(loadedIndex);
      }, 250);
    });
    const show = (index) => {
      active = (index + galleryImages.length) % galleryImages.length;
      const item = galleryImages[active];
      if (avifSource instanceof HTMLSourceElement) avifSource.srcset = item.avifSrcset;
      if (image) {
        image.srcset = item.srcset;
        image.sizes = item.sizes;
        image.src = item.src;
        image.width = item.width;
        image.height = item.height;
        image.alt = item.alt;
      }
      if (caption) caption.textContent = item.caption || item.alt;
      if (counter) counter.textContent = `${active + 1} / ${galleryImages.length}`;
    };
    document.querySelectorAll('[data-gallery-index]').forEach((button) => {
      button.addEventListener('click', () => {
        show(Number(button.dataset.galleryIndex));
        dialog.showModal();
      });
    });
    dialog.querySelector('.lightbox__close')?.addEventListener('click', () => dialog.close());
    dialog.querySelector('.lightbox__previous')?.addEventListener('click', () => show(active - 1));
    dialog.querySelector('.lightbox__next')?.addEventListener('click', () => show(active + 1));
    dialog.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); });
    dialog.addEventListener('close', () => window.clearTimeout(warmTimer));
    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') show(active - 1);
      if (event.key === 'ArrowRight') show(active + 1);
    });
  }
</script>

<style>
  .heritage-site { --ink: #171512; --paper: #f4f0e8; --warm: #9a7652; --line: rgba(23, 21, 18, .16); background: #fff; color: var(--ink); }

---
interface GalleryVariant {
  src: string;
  width: number;
  height: number;
}

interface GalleryItem {
  id: string;
  categoryId: string;
  alt: string;
  variants: GalleryVariant[];
}

interface GalleryCategory {
  id: string;
  label: string;
  description: string;
  count: number;
}

interface GalleryData {
  categories: GalleryCategory[];
  items: GalleryItem[];
}

interface Props {
  villa: any;
  slug: string;
  lang: string;
  gallery: GalleryData;
  homeHref?: string;
  assetSlug?: string;
}

const {
  villa,
  slug,
  lang,
  gallery,
  homeHref = `/villas/${slug}/${lang}/`,
  assetSlug = slug,
} = Astro.props;
const galleryAssetBase = `/images/villas/${assetSlug}/gallery`;

const items = gallery.items.map((item) => ({
  ...item,
  variants: item.variants.map((variant) => ({
    ...variant,
    src: `${galleryAssetBase}/${variant.src.split('/').at(-1)}`,
  })),
}));

const groupedItems = gallery.categories.map((category) => ({
  ...category,
  items: items.filter((item) => item.categoryId === category.id),
}));

const galleryVariant = (item: GalleryItem, preferredWidth: number) =>
  item.variants.find(({ width }) => width >= preferredWidth) ?? item.variants.at(-1);

const gallerySrcSet = (item: GalleryItem) =>
  item.variants.map(({ src, width }) => `${src} ${width}w`).join(', ');

const lightboxItems = items.flatMap((item) => {
  const fallback = item.variants.at(-1) ?? item.variants[0];
  return fallback ? [{
    src: fallback.src,
    srcset: gallerySrcSet(item),
    width: fallback.width,
    height: fallback.height,
    alt: item.alt,
  }] : [];
});
---

<div class="heritage-gallery" data-complete-gallery>
  <section class="gallery-intro">
    <div class="gallery-shell gallery-intro__inner">
      <a class="gallery-back" href={`${homeHref}#gallery`}>
        <span aria-hidden="true">&larr;</span> Back to the estate
      </a>
      <p class="gallery-eyebrow">The complete collection</p>
      <h1>{villa.name}</h1>
      <p class="gallery-intro__copy">
        Move through the estate by chapter, or open any photograph for a closer view.
        All {items.length} photographs were supplied and approved by the owners.
      </p>
    </div>
  </section>

  <div class="gallery-shell gallery-layout">
    <aside class="gallery-index" aria-label="Gallery chapters">
      <p>Explore</p>
      <nav>
        {groupedItems.map((category, index) => (
          <a href={`#${category.id}`} data-gallery-chapter-link>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <strong>{category.label}</strong>
            <small>{category.items.length}</small>
          </a>
        ))}
      </nav>
    </aside>

    <div class="gallery-collection">
      {groupedItems.map((category, categoryIndex) => (
        <section
          class="gallery-chapter"
          id={category.id}
          aria-labelledby={`${category.id}-heading`}
          data-gallery-chapter
        >
          <header>
            <span>{String(categoryIndex + 1).padStart(2, '0')}</span>
            <div>
              <h2 id={`${category.id}-heading`}>{category.label}</h2>
              <p>{category.description}</p>
            </div>
            <small>
              {category.items.length} {category.items.length === 1 ? 'image' : 'images'}
            </small>
          </header>

          <div class="gallery-mosaic">
            {category.items.map((item, index) => {
              const thumbnail = galleryVariant(item, 480);
              const globalIndex = items.findIndex(({ id }) => id === item.id);
              return thumbnail && (
                <button
                  class:list={[
                    'gallery-card',
                    { 'gallery-card--wide': index % 7 === 0 || index % 7 === 5 },
                  ]}
                  type="button"
                  aria-label={`Open ${category.label.toLowerCase()} image ${index + 1}: ${item.alt}`}
                  data-gallery-open
                  data-index={globalIndex}
                >
                  <img
                    src={thumbnail.src}
                    srcset={gallerySrcSet(item)}
                    sizes="(max-width: 700px) 50vw, (max-width: 1100px) 33vw, 28vw"
                    alt={item.alt}
                    width={thumbnail.width}
                    height={thumbnail.height}
                    loading={categoryIndex === 0 && index === 0 ? 'eager' : 'lazy'}
                    fetchpriority={categoryIndex === 0 && index === 0 ? 'high' : 'auto'}
                    decoding="async"
                  />
                  <span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                </button>
              );
            })}
          </div>
        </section>
      ))}
    </div>
  </div>

  <dialog class="gallery-lightbox" aria-label={`${villa.name} complete gallery`} data-gallery-modal>
    <div class="gallery-lightbox__bar">
      <a href={homeHref}>{villa.name}</a>
      <p><span data-gallery-current>1</span> / {items.length}</p>
      <button type="button" aria-label="Close gallery" data-gallery-close>&times;</button>
    </div>
    <div class="gallery-lightbox__stage">
      <button type="button" aria-label="Previous image" data-gallery-previous>&larr;</button>
      <figure>
        <img data-gallery-image alt="" />
        <figcaption data-gallery-caption></figcaption>
      </figure>
      <button type="button" aria-label="Next image" data-gallery-next>&rarr;</button>
    </div>
  </dialog>

  <script
    is:inline
    type="application/json"
    data-gallery-data
    set:html={JSON.stringify(lightboxItems)}
  />
</div>

<style>
  .heritage-gallery {
    --gallery-ink: #171512;
    --gallery-paper: #f4f0e8;
    --gallery-warm: #9a7652;
    --gallery-muted: #6b645c;
    --gallery-line: rgba(23, 21, 18, 0.16);
    min-height: 100vh;
    background: #fbfaf7;
    color: var(--gallery-ink);
  }

  .gallery-shell {
    width: min(1420px, calc(100% - 64px));
    margin: 0 auto;
  }

  .gallery-intro {
    padding: clamp(154px, 17vw, 238px) 0 clamp(78px, 9vw, 132px);
    background:
      radial-gradient(circle at 88% 12%, rgba(154, 118, 82, 0.12), transparent 32%),
      var(--gallery-paper);
  }

  .gallery-intro__inner {
    display: grid;
  }

  .gallery-back {
    width: fit-content;
    color: var(--gallery-muted);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .gallery-back span {
    margin-right: 10px;
    color: var(--gallery-warm);
  }

  .gallery-eyebrow {
    margin: clamp(66px, 8vw, 110px) 0 24px;
    color: var(--gallery-warm);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .gallery-intro h1 {
    max-width: 1120px;
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(4.8rem, 10vw, 10.8rem);
    font-weight: 400;
    letter-spacing: -0.055em;
    line-height: 0.78;
  }

  .gallery-intro__copy {
    max-width: 650px;
    margin: clamp(46px, 6vw, 78px) 0 0 auto;
    color: var(--gallery-muted);
    font-size: clamp(1rem, 1.3vw, 1.18rem);
    line-height: 1.8;
  }

  .gallery-layout {
    padding: clamp(84px, 10vw, 148px) 0 clamp(120px, 14vw, 210px);
    display: grid;
    grid-template-columns: 210px minmax(0, 1fr);
    gap: clamp(46px, 7vw, 100px);
    align-items: start;
  }

  .gallery-index {
    position: sticky;
    top: 100px;
  }

  .gallery-index > p {
    margin: 0 0 22px;
    color: var(--gallery-warm);
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .gallery-index nav {
    display: grid;
  }

  .gallery-index a {
    padding: 14px 0;
    border-top: 1px solid var(--gallery-line);
    display: grid;
    grid-template-columns: 28px 1fr auto;
    gap: 8px;
    align-items: baseline;
    color: var(--gallery-muted);
    text-decoration: none;
  }

  .gallery-index a:last-child {
    border-bottom: 1px solid var(--gallery-line);
  }

  .gallery-index span,
  .gallery-index small {
    color: var(--gallery-warm);
    font-size: 0.62rem;
  }

  .gallery-index strong {
    font-family: var(--font-serif);
    font-size: 1rem;
    font-weight: 500;
  }

  .gallery-index a:hover strong,
  .gallery-index a.is-active strong {
    color: var(--gallery-ink);
  }

  .gallery-collection {
    min-width: 0;
    display: grid;
    gap: clamp(100px, 13vw, 180px);
  }

  .gallery-chapter {
    scroll-margin-top: 104px;
    content-visibility: auto;
    contain-intrinsic-block-size: auto 1200px;
  }

  .gallery-chapter > header {
    margin-bottom: clamp(30px, 5vw, 56px);
    display: grid;
    grid-template-columns: 42px minmax(0, 1fr) auto;
    gap: 20px;
    align-items: start;
  }

  .gallery-chapter > header > span,
  .gallery-chapter > header > small {
    color: var(--gallery-warm);
    font-family: var(--font-serif);
    font-size: 0.8rem;
    letter-spacing: 0.08em;
  }

  .gallery-chapter h2 {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(2.5rem, 5vw, 4.8rem);
    font-weight: 400;
    letter-spacing: -0.035em;
    line-height: 0.96;
  }

  .gallery-chapter header p {
    max-width: 560px;
    margin: 16px 0 0;
    color: var(--gallery-muted);
    font-size: 0.88rem;
    line-height: 1.7;
  }

  .gallery-mosaic {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-auto-flow: dense;
    gap: 8px;
  }

  .gallery-card {
    min-width: 0;
    aspect-ratio: 4 / 3;
    padding: 0;
    border: 0;
    overflow: hidden;
    position: relative;
    background: #dedbd5;
    cursor: zoom-in;
  }

  .gallery-card--wide {
    grid-column: span 2;
    aspect-ratio: 16 / 9;
  }

  .gallery-card img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    transition: transform 0.7s ease;
  }

  .gallery-card:hover img {
    transform: scale(1.025);
  }

  .gallery-card > span {
    position: absolute;
    right: 13px;
    bottom: 10px;
    color: rgba(255, 255, 255, 0.92);
    font-family: var(--font-serif);
    font-size: 0.78rem;
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.52);
  }

  .gallery-lightbox {
    width: 100vw;
    max-width: none;
    height: 100vh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgba(7, 7, 7, 0.985);
    color: #fff;
  }

  .gallery-lightbox::backdrop {
    background: rgba(7, 7, 7, 0.985);
  }

  .gallery-lightbox[open] {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
  }

  .gallery-lightbox__bar {
    min-height: 72px;
    padding: 14px clamp(18px, 4vw, 58px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
  }

  .gallery-lightbox__bar a {
    color: #fff;
    font-family: var(--font-serif);
    text-decoration: none;
  }

  .gallery-lightbox__bar p {
    margin: 0;
    color: rgba(255, 255, 255, 0.62);
    font-family: var(--font-serif);
  }

  .gallery-lightbox__bar button {
    justify-self: end;
  }

  .gallery-lightbox button {
    width: 44px;
    height: 44px;
    border: 1px solid rgba(255, 255, 255, 0.25);
    background: transparent;
    color: #fff;
    cursor: pointer;
  }

  .gallery-lightbox__stage {
    min-height: 0;
    padding: 22px clamp(14px, 3vw, 42px) 26px;
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr) 48px;
    gap: clamp(10px, 2vw, 28px);
    align-items: center;
  }

  .gallery-lightbox figure {
    min-width: 0;
    min-height: 0;
    height: 100%;
    margin: 0;
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    gap: 12px;
    justify-items: center;
  }

  .gallery-lightbox figure img {
    width: 100%;
    height: 100%;
    min-height: 0;
    object-fit: contain;
  }

  .gallery-lightbox figcaption {
    color: rgba(255, 255, 255, 0.6);
    font-size: 0.72rem;
    text-align: center;
  }

  @media (max-width: 900px) {
    .gallery-layout {
      grid-template-columns: 1fr;
    }

    .gallery-index {
      z-index: 5;
      top: 69px;
      margin-inline: calc((100vw - 100%) / -2);
      padding: 0 18px;
      overflow-x: auto;
      background: rgba(251, 250, 247, 0.96);
      backdrop-filter: blur(14px);
    }

    .gallery-index > p {
      display: none;
    }

    .gallery-index nav {
      width: max-content;
      display: flex;
    }

    .gallery-index a {
      min-width: max-content;
      padding: 14px 18px 13px 0;
      border-top: 0;
      border-bottom: 1px solid var(--gallery-line);
      grid-template-columns: auto auto;
    }

    .gallery-index a + a {
      padding-left: 18px;
    }

    .gallery-index small {
      display: none;
    }
  }

  @media (max-width: 700px) {
    .gallery-shell {
      width: min(100% - 28px, 1420px);
    }

    .gallery-intro {
      padding-top: 126px;
    }

    .gallery-intro h1 {
      font-size: clamp(3.5rem, 17vw, 5.5rem);
      line-height: 0.84;
    }

    .gallery-chapter > header {
      grid-template-columns: 30px minmax(0, 1fr);
    }

    .gallery-chapter > header > small {
      display: none;
    }

    .gallery-mosaic {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 5px;
    }

    .gallery-card--wide {
      grid-column: span 2;
    }

    .gallery-lightbox__bar {
      grid-template-columns: 1fr auto;
    }

    .gallery-lightbox__bar p {
      display: none;
    }

    .gallery-lightbox__stage {
      padding-inline: 10px;
      grid-template-columns: 42px minmax(0, 1fr) 42px;
      gap: 6px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gallery-card img {
      transition: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-complete-gallery]').forEach((gallery) => {
    const modal = gallery.querySelector<HTMLDialogElement>('[data-gallery-modal]');
    const data = gallery.querySelector<HTMLScriptElement>('[data-gallery-data]');
    const image = gallery.querySelector<HTMLImageElement>('[data-gallery-image]');
    const caption = gallery.querySelector<HTMLElement>('[data-gallery-caption]');
    const current = gallery.querySelector<HTMLElement>('[data-gallery-current]');
    if (!modal || !data || !image || !caption || !current) return;

    const items = JSON.parse(data.textContent ?? '[]') as Array<{
      src: string;
      srcset: string;
      width: number;
      height: number;
      alt: string;
    }>;
    let active = 0;
    let opener: HTMLElement | null = null;
    const show = (index: number) => {
      active = (index + items.length) % items.length;
      const item = items[active];
      image.srcset = item.srcset;
      image.sizes = '100vw';
      image.src = item.src;
      image.width = item.width;
      image.height = item.height;
      image.alt = item.alt;
      caption.textContent = item.alt;
      current.textContent = String(active + 1);
    };

    gallery.querySelectorAll<HTMLButtonElement>('[data-gallery-open]').forEach((button) => {
      button.addEventListener('click', () => {
        opener = button;
        show(Number(button.dataset.index ?? 0));
        modal.showModal();
      });
    });

    gallery.querySelector('[data-gallery-close]')?.addEventListener('click', () => modal.close());
    gallery.querySelector('[data-gallery-previous]')?.addEventListener('click', () => show(active - 1));
    gallery.querySelector('[data-gallery-next]')?.addEventListener('click', () => show(active + 1));
    modal.addEventListener('click', (event) => {
      if (event.target === modal) modal.close();
    });
    modal.addEventListener('close', () => opener?.focus());
    modal.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') show(active - 1);
      if (event.key === 'ArrowRight') show(active + 1);
    });

    const chapterLinks = Array.from(gallery.querySelectorAll<HTMLAnchorElement>('[data-gallery-chapter-link]'));
    const chapters = Array.from(gallery.querySelectorAll<HTMLElement>('[data-gallery-chapter]'));
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
        if (!visible) return;
        chapterLinks.forEach((link) => {
          link.classList.toggle('is-active', link.hash === `#${visible.target.id}`);
        });
      }, { rootMargin: '-20% 0px -65% 0px', threshold: [0, 0.1] });
      chapters.forEach((chapter) => observer.observe(chapter));
    }
  });
</script>
